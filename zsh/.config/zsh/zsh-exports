# XDG_*, ZDOTDIR, and Z*DIR are set in ~/.zshenv, which always runs first.

# History handling. Not exported: child shells (e.g. bash) would otherwise
# inherit HISTFILE and write their own history into the zsh file.
HISTFILE="$ZSTATEDIR/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

export EDITOR=nvim
export VISUAL=nvim

export LANG="en_US.UTF-8"

# GOLANG
export GOPATH=$HOME/workspace/go

# `path` is unique (typeset -U in .zshenv), so appending is idempotent.
path+=("$HOME/.config/bin" "$HOME/.local/bin" "$GOPATH/bin")

# AWS
export AWS_REGION=us-east-1
export AWS_SDK_LOAD_CONFIG=1

# FZF
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'

# MISE
# Auto-trust mise configs under repo main branches and herdr worktrees
export MISE_TRUSTED_CONFIG_PATHS="$HOME/workspaces:$HOME/.local/share/herdr/worktrees"

# Terraform
export TF_PLUGIN_CACHE_DIR="$XDG_CACHE_HOME/terraform/plugin-cache"

# proto (moon toolchain store)
export PROTO_HOME="$XDG_DATA_HOME/proto"
