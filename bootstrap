#!/usr/bin/env bash

# Resolve this script's real directory so mise always runs from the dotfiles
# root, regardless of the caller's current working directory or symlinks.
resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  local dir

  if [[ "$source" != */* ]]; then
    source=$(command -v -- "$source")
  fi

  while [[ -L "$source" ]]; do
    dir=$(CDPATH= cd -P -- "$(dirname -- "$source")" >/dev/null 2>&1 && pwd)
    source=$(readlink -- "$source")
    [[ "$source" != /* ]] && source="$dir/$source"
  done

  CDPATH= cd -P -- "$(dirname -- "$source")" >/dev/null 2>&1 && pwd
}

SCRIPT_DIR=$(resolve_script_dir)

# Logging utilities
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() {
  echo -e "[${GREEN}INFO${NC}] $1"
}

log_warn() {
  echo -e "[${YELLOW}WARN${NC}] $1"
}

log_error() {
  echo -e "[${RED}ERROR${NC}] $1"
}

# Installs Mise if not installed
if ! command -v mise &>/dev/null; then
  log_info "Installing Mise..."

  curl https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
else
  log_info "Mise is already installed"
fi

# Trust dotfiles configuration files
mise --cd "$SCRIPT_DIR" trust --yes

# Install dotfile dependencies
mise --cd "$SCRIPT_DIR" install

# Apply dotfiles from the [dotfiles] section of mise.toml
log_info "Applying dotfiles"
mise --cd "$SCRIPT_DIR" dotfiles apply --yes

# Global mise tools now installed
log_info "Installing all tools"
mise --cd "$SCRIPT_DIR" install
